# ==========================================
# Medaf Supply Chain - Backend Environment Variables Template
# ==========================================

# Server Port (default: 3001)
PORT=3001
BACKEND_URL=http://localhost:3001

# Environment Mode: Set to 'true' for local development, 'false' for production/remote DB
LOCAL=true

# Frontend URLs (Used for CORS and Invitation Links)
FRONTEND_URL_LOCAL=http://localhost:3000
FRONTEND_URL_PRODUCTION=https://medaf-supply-chain.vercel.app

# ==========================================
# Database Configuration
# ==========================================
# Used when LOCAL=true
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=medaf_supply_chain

# Used when LOCAL=false (e.g. Neon, Supabase, AWS RDS, Railway)
DATABASE_URL=postgresql://username:password@host:5432/database_name?sslmode=require

# ==========================================
# Authentication & Security
# ==========================================
JWT_SECRET=your_jwt_secret_key_here

# ==========================================
# Admin Account Seeding (Auto-created/synced on startup)
# ==========================================
ADMIN_EMAIL=admin@medafsupplychain.com
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin

# ==========================================
# Cloudinary (Image & Document Uploads)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
