# ==============================================================================
# Medaf Supply Chain - Backend Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Routing Settings
# ------------------------------------------------------------------------------
# In cPanel Phusion Passenger, PORT is managed automatically or defaults to 3001
PORT=3001

# The public URL of the backend (e.g. https://api.yourdomain.com or https://yourdomain.com/api)
# Used for generating full URLs for uploaded assets and media files.
BACKEND_URL=https://api.yourdomain.com

# Frontend URL(s) for CORS and User Invitation links.
# You can provide a single URL or comma-separated list of allowed domains:
# FRONTEND_URL=https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Legacy fallback compatibility
FRONTEND_URL_LOCAL=http://localhost:3000
FRONTEND_URL_PRODUCTION=https://yourdomain.com

# ------------------------------------------------------------------------------
# 2. Environment Mode
# ------------------------------------------------------------------------------
# Set to 'false' for cPanel / production deployments.
# Set to 'true' only when developing locally.
LOCAL=false

# ------------------------------------------------------------------------------
# 3. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# OPTION A: cPanel Local PostgreSQL (Created via cPanel PostgreSQL Databases)
# On cPanel servers, local PostgreSQL typically runs on localhost without SSL.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=your_db_password
DB_NAME=cpaneluser_dbname
DB_SSL=false

# OPTION B: Cloud PostgreSQL (Neon, Supabase, Render, AWS RDS, Railway)
# If using a remote cloud database, supply the DATABASE_URL connection string:
# DATABASE_URL=postgresql://username:password@host:5432/database_name?sslmode=require
# DB_SSL=true

# Auto-sync TypeORM schema tables on startup (default: true)
DB_SYNCHRONIZE=true

# ------------------------------------------------------------------------------
# 4. Authentication & Security
# ------------------------------------------------------------------------------
# Strong random secret key for signing JWT tokens (generate a 64+ char random string)
JWT_SECRET=replace_with_a_long_cryptographically_secure_secret_key_2026

# ------------------------------------------------------------------------------
# 5. Default Super Admin Account (Auto-seeded on first run)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin

# ------------------------------------------------------------------------------
# 6. Cloudinary (Optional fallback for external cloud media storage)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
